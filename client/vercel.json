{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://edw-jvpw.vercel.app/sitemap.xml"
    },
    {
      "source": "/merchant-feed.xml",
      "destination": "https://edw-jvpw.vercel.app/merchant-feed.xml"
    },
    {
      "source": "/api/:path*",
      "destination": "https://edw-jvpw.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(apple-touch-icon.png|eshaz-dream-world-social-2026.jpg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/profile/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(checkout|cart|wishlist|custom-orders|track-order|order-success|order-failed|login|register|forgot-password|faq|shipping|returns|privacy|terms)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(orders|order|reset-password)/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
